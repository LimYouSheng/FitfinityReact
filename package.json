{
  "name": "fitfinity-canonical-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages-test": "vite build --base=/FitfinityReact/ --outDir=dist-pages",
    "verify:pwa": "node scripts/verify-pwa.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && npm run build:pages-test && npm run verify:pwa -- dist / && npm run verify:pwa -- dist-pages /FitfinityReact/ && playwright test"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@vitejs/plugin-react": "latest",
    "jsdom": "latest",
    "vite": "^8.1.0",
    "vitest": "^4.1.0"
  }
}
